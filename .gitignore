_docker_reference/
review_references/
*.zip
*.mview

# --- Legacy reference tree (never tracked; safety net for stray copies) ---
# Any stray directory carrying these names in the repo root is a
# leftover reference snapshot from an earlier phase (ADR 0040
# clean-room methodology). Kept in .gitignore as a safety net so an
# accidental `git add -A` in a fresh clone with an unpacked snapshot
# doesn't commit them.
/batch/
/css/
/dbstruct/
/documentation/
/gfx/
/iccprofiles/
/include/
/js/
/languages/
/lib/
/pages/
/plugins/
/upgrade/
/tests/
/templates/
/api/
/.well-known/
/composer.json
/composer.lock
/index.php
/login.php
/license.txt
/manifest.json
/package.json
/pnpm-lock.yaml
/phpcs.xml.dist
/phpstan-baseline.neon
/phpstan.neon.dist
/rector.php
/robots.txt
/.svnignore

# Local asset storage. Bind-mounted into containers; never committed.
filestore/
/logs/
*.log

# --- PHP / Composer ---
vendor/
.phpunit.cache/
.phpunit.result.cache
.phpcs-cache
coverage/

