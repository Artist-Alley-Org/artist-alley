# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Local reference materials (not part of the project) ---
_docker_reference/
review_references/
*.zip
*.mview

# --- Legacy reference tree (never tracked; safety net for stray copies) ---
# Any stray directory carrying these names in the repo root is a
# leftover reference snapshot from an earlier phase (ADR 0040
# clean-room methodology). Kept in .gitignore as a safety net so an
# accidental `git add -A` in a fresh clone with an unpacked snapshot
# doesn't commit them.
/batch/
/css/
/dbstruct/
/documentation/
/gfx/
/iccprofiles/
/include/
/js/
/languages/
/lib/
/pages/
/plugins/
/upgrade/
/tests/
/templates/
/api/
/.well-known/
/composer.json
/composer.lock
/index.php
/login.php
/license.txt
/manifest.json
/package.json
/pnpm-lock.yaml
/phpcs.xml.dist
/phpstan-baseline.neon
/phpstan.neon.dist
/rector.php
/robots.txt
/.svnignore

# Local asset storage. Bind-mounted into containers; never committed.
filestore/
/logs/
*.log

# --- PHP / Composer ---
vendor/
.phpunit.cache/
.phpunit.result.cache
.phpcs-cache
coverage/

# --- Node / pnpm / build outputs ---
node_modules/
.svelte-kit/
dist/
build/
.vite/
.turbo/

# --- Go ---
services/**/bin/
services/**/*.exe
services/**/coverage.out

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- IDE / OS / Claude state ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# --- Docker / runtime ---
*.pid
.docker-data/

# --- Seed apply runtime state ---
# Created by seed/scripts/apply.py, one per target instance (e.g.
# apply-state-localhost-b.json). Local to each dogfood run; never
# tracked.
apply-state-*.json

# --- Reference-only plugin dirs (kept locally, used as blueprints) ---
ref_grouping/
ref_annotations/
.playwright-mcp/
Reference_Plugins/

# --- Local demo seeders (reference an external dataset; kept off main) ---
scripts/seed-demo-studio.py
scripts/seed-demo-pokemon-shuffle.sql
collections-*.png
project-*.png
browse-*.png
post-*.png

# Per-format engine A/B sweep outputs (regenerated by
# scripts/blender/ab_engine_test.py).
web/static/ab/

# Local ABR brush-pack extraction output + the compiled CLI binary
# (regenerated by scripts/regen-abr.sh / the aa-abr-extract CLI).
_abr-test-out/
app/aa-abr-extract
*.abr

# Test-source media kept under the project root — never commit. Used
# by ingest scripts (Dresden Files .m4b, Dark Tower MP3 folders,
# .mview models, etc).
/Book ?*/
/The Dresden Files *
/*.m4b
/*.mview
/*.aax
/*.key
/*.cue

# Smoke-test screenshots captured by Playwright during dev.
/audiobook-*.png
/doc-*.png
/model-*.png
/epub-tool-*.png
/test-*.png
/firing_squad/
kaggle.txt
.dogfood-runs
app/.cache/
