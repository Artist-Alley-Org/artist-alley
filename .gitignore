.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# --- Docker / runtime ---
*.pid
.docker-data/

# --- Seed apply runtime state ---
# Created by seed/scripts/apply.py, one per target instance (e.g.
# apply-state-localhost-b.json). Local to each dogfood run; never
# tracked.
apply-state-*.json

# --- Reference-only plugin dirs (kept locally, used as blueprints) ---
.playwright-mcp/
Reference_Plugins/

# --- Local demo seeders (reference an external dataset; kept off main) ---
scripts/seed-demo-studio.py
scripts/seed-demo-pokemon-shuffle.sql
/collections-*.png
/project-*.png
/browse-*.png
/post-*.png

# Per-format engine A/B sweep outputs. The generator
# (scripts/blender/ab_engine_test.py) left with Blender in #500; this
# entry stays so any leftover local output remains ignored.
web/static/ab/

# Local ABR brush-pack extraction output + the compiled CLI binary
# (regenerated by scripts/regen-abr.sh / the aa-abr-extract CLI).
_abr-test-out/
app/aa-abr-extract
*.abr

# Test-source media kept under the project root — never commit. Used
# by ingest scripts (Dresden Files .m4b, Dark Tower MP3 folders,
# .mview models, etc).
/Book ?*/
/The Dresden Files *
/*.m4b
/*.mview
/*.aax
/*.key
/*.cue

# Smoke-test screenshots captured by Playwright during dev.
/audiobook-*.png
/doc-*.png
/model-*.png
/epub-tool-*.png
/test-*.png
/firing_squad/
kaggle.txt
.dogfood-runs
app/.cache/
logos/*
kaggle.json

# Playwright writes verification screenshots to the WORKSPACE ROOT, not
# to .playwright-mcp/ — so every UI check leaves untracked .png files
# behind, which dirty the tree and block the reindex step of close-out.
# Real screenshots are committed under docs/screenshots/, so ignoring
# root-level ones only ever hides throwaway artifacts.
/*.png

# local design references — never committed
reference_pages/*

# --- Playwright dogfood screenshots (#1211) ---
# The suite writes every screenshot through `testInfo.outputPath()`, which
# lands under scripts/dogfood/ui/.pw-results/ (already ignored there). These
# two patterns are the safety net for the failure that produced #1211: a
# spec passing a repo-relative `path:` overwrote TRACKED PNGs in
# scripts/dogfood/ui/ on every local run, and the diff was swept into
# unrelated commits twice. Nothing in that directory is a real artifact —
# fixtures/ (the IIIF source image) is a subdirectory and is not matched.
/scripts/dogfood/ui/*.png
# Agents' per-sprint screenshot folders in the coding worktree (.shots-1207/,
# .shots-sprint1/, …). Handed to the operator by absolute path, never committed.
.shots-*/
