<!doctype html>
<html>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.5; color: #1f2937; max-width: 560px; margin: 32px auto; padding: 0 16px;">
    <p>Hi {{.recipient_name}},</p>
    <p>There's new activity on <a href="{{.site_url}}" style="color: #2563eb;">{{.site_name}}</a>:</p>
    <p style="background:#f3f4f6; padding:12px 16px; border-radius:6px; font-family:monospace;">
      {{.verb}}{{if .target_kind}} <span style="color:#6b7280;">({{.target_kind}})</span>{{end}}
    </p>
    <p><a href="{{.site_url}}" style="color: #2563eb;">Open {{.site_name}}</a> to see it.</p>
    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;">
    <p style="color: #6b7280; font-size: 12px;">
      You're receiving this because email notifications are enabled for <code>{{.verb}}</code>.
      <a href="{{.site_url}}/account/notifications" style="color: #6b7280;">Manage your preferences</a>.
    </p>
  </body>
</html>
