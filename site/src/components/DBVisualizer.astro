---
// Interactive schema visualizer. Consumes build-time src/data/schema.json
// produced by site/scripts/generate-schema-docs.mjs and embeds a Cytoscape
// graph with domain-coloured nodes, FK edges, domain-filter checkboxes, and
// a free-text search.
//
// No SSR for the graph itself — Cytoscape needs a DOM container, so the
// rendering happens client-side in a small inline <script>. The schema
// data is injected as a JSON blob in a <script type="application/json">
// tag so the script can read it without an extra fetch.

import schemaData from "../data/schema.json";

const dataJson = JSON.stringify(schemaData);
---

<div class="dbv-shell" data-dbv>
  <header class="dbv-toolbar">
    <label class="dbv-search">
      <span class="dbv-search-label">Search tables</span>
      <input
        type="search"
        placeholder="Search by table name, summary, domain…"
        data-dbv-search
        autocomplete="off"
        spellcheck="false"
      />
    </label>

    <div class="dbv-domains" data-dbv-domains>
      <span class="dbv-domains-label">Domains</span>
      <div class="dbv-domain-buttons">
        <button type="button" class="dbv-domain-all" data-dbv-all>All</button>
        <button type="button" class="dbv-domain-none" data-dbv-none>None</button>
      </div>
      <div class="dbv-domain-list" data-dbv-domain-list></div>
    </div>

    <div class="dbv-actions">
      <button type="button" data-dbv-relayout title="Re-run the force-directed layout">Re-layout</button>
      <button type="button" data-dbv-fit title="Fit graph to viewport">Fit</button>
    </div>
  </header>

  <div class="dbv-stage">
    <div class="dbv-canvas" data-dbv-canvas></div>
    <aside class="dbv-info" data-dbv-info aria-live="polite">
      <p class="dbv-info-hint">
        Click a node to open its detail page · drag a node to rearrange ·
        scroll to zoom · drag empty space to pan.
      </p>
    </aside>
  </div>

  <script type="application/json" data-dbv-data set:html={dataJson}></script>
</div>

<script>
  import cytoscape from "cytoscape";
  import coseBilkent from "cytoscape-cose-bilkent";

  cytoscape.use(coseBilkent);

  type DomainId =
    | "identity" | "teams" | "assets" | "metadata" | "collections"
    | "posts" | "workflow" | "storage" | "social" | "audit"
    | "jobs" | "annotations" | "system" | "other";

  // Domain → brand-aligned colour palette. Pulled from the project's
  // --aa-* tokens so it sits next to the rest of the site cleanly.
  const DOMAIN_COLOURS: Record<DomainId, string> = {
    identity:    "#7c3aed",  // feature purple
    teams:       "#a855f7",
    assets:      "#2ea043",  // shipped green
    metadata:    "#0ea5e9",
    collections: "#f59e0b",
    posts:       "#ec4899",
    workflow:    "#d29922",  // inflight amber
    storage:     "#06b6d4",
    social:      "#84cc16",
    audit:       "#ef4444",
    jobs:        "#8b5cf6",
    annotations: "#14b8a6",
    system:      "#6e7681",  // planned grey
    other:       "#9ca3af",
  };

  type SchemaNode = {
    id: string;
    label: string;
    domain: DomainId;
    slug: string;
    summary: string;
    columnCount: number;
    fkOutCount: number;
    fkInCount: number;
  };
  type SchemaEdge = {
    source: string;
    target: string;
    column: string;
    nullable: boolean;
  };
  type SchemaDomain = { id: DomainId; title: string; summary: string };
  type SchemaData = {
    generatedAt: string;
    domains: SchemaDomain[];
    nodes: SchemaNode[];
    edges: SchemaEdge[];
  };

  function init(root: HTMLElement) {
    const dataEl = root.querySelector<HTMLScriptElement>("[data-dbv-data]");
    if (!dataEl?.textContent) return;
    const data = JSON.parse(dataEl.textContent) as SchemaData;

    const canvas = root.querySelector<HTMLElement>("[data-dbv-canvas]");
    const infoEl = root.querySelector<HTMLElement>("[data-dbv-info]");
    const searchInput = root.querySelector<HTMLInputElement>("[data-dbv-search]");
    const domainListEl = root.querySelector<HTMLElement>("[data-dbv-domain-list]");
    if (!canvas || !domainListEl) return;

    // Render the per-domain checkbox row.
    const enabled = new Set<DomainId>(data.domains.map((d) => d.id));
    const totalsByDomain: Record<string, number> = {};
    for (const n of data.nodes) {
      totalsByDomain[n.domain] = (totalsByDomain[n.domain] ?? 0) + 1;
    }
    for (const d of data.domains) {
      const id = `dbv-domain-${d.id}`;
      const wrap = document.createElement("label");
      wrap.className = "dbv-domain-chip";
      wrap.style.setProperty("--dbv-domain-color", DOMAIN_COLOURS[d.id] ?? "#999");
      wrap.innerHTML = `
        <input type="checkbox" id="${id}" data-dbv-domain="${d.id}" checked />
        <span class="dbv-domain-swatch" aria-hidden="true"></span>
        <span class="dbv-domain-name">${d.title}</span>
        <span class="dbv-domain-count">${totalsByDomain[d.id] ?? 0}</span>
      `;
      domainListEl.appendChild(wrap);
    }

    // Cytoscape elements.
    const cyElements = [
      ...data.nodes.map((n) => ({
        group: "nodes" as const,
        data: {
          id: n.id,
          label: n.label,
          domain: n.domain,
          slug: n.slug,
          summary: n.summary,
          colour: DOMAIN_COLOURS[n.domain] ?? "#999",
          size: Math.min(
            70,
            18 + Math.log2(1 + n.columnCount + n.fkOutCount + n.fkInCount) * 7,
          ),
          fkOutCount: n.fkOutCount,
          fkInCount: n.fkInCount,
          columnCount: n.columnCount,
        },
      })),
      ...data.edges.map((e, i) => ({
        group: "edges" as const,
        data: {
          id: `e${i}`,
          source: e.source,
          target: e.target,
          column: e.column,
          nullable: e.nullable,
        },
      })),
    ];

    const cy = cytoscape({
      container: canvas,
      elements: cyElements,
      wheelSensitivity: 0.2,
      minZoom: 0.15,
      maxZoom: 3,
      style: [
        {
          selector: "node",
          style: {
            "background-color": "data(colour)",
            "border-color": "data(colour)",
            "border-width": 2,
            "border-opacity": 0.8,
            "label": "data(label)",
            "color": "#e6edf3",
            "font-size": 11,
            "font-family":
              "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
            "text-valign": "bottom",
            "text-halign": "center",
            "text-margin-y": 4,
            "text-outline-color": "#0d1117",
            "text-outline-width": 2,
            "width": "data(size)",
            "height": "data(size)",
            "transition-property":
              "border-width, border-color, background-color, opacity",
            "transition-duration": 120,
          } as any,
        },
        {
          selector: "node:selected",
          style: {
            "border-color": "#ffffff",
            "border-width": 4,
          } as any,
        },
        {
          selector: "node.dimmed",
          style: {
            "opacity": 0.18,
          } as any,
        },
        {
          selector: "node.match",
          style: {
            "border-color": "#ffffff",
            "border-width": 4,
          } as any,
        },
        {
          selector: "edge",
          style: {
            "width": 1.4,
            "line-color": "#6e7681",
            "line-opacity": 0.65,
            "target-arrow-shape": "triangle",
            "target-arrow-color": "#6e7681",
            "curve-style": "bezier",
            "arrow-scale": 0.8,
          } as any,
        },
        {
          selector: "edge[?nullable]",
          style: {
            "line-style": "dashed",
            "line-opacity": 0.45,
          } as any,
        },
        {
          selector: "edge.dimmed",
          style: { "opacity": 0.08 } as any,
        },
        {
          selector: "edge.highlight",
          style: {
            "width": 2.5,
            "line-color": "#7c3aed",
            "target-arrow-color": "#7c3aed",
            "line-opacity": 1,
            "z-index": 99,
          } as any,
        },
      ],
      layout: {
        name: "cose-bilkent",
        animate: false,
        nodeDimensionsIncludeLabels: true,
        nodeRepulsion: 12000,
        idealEdgeLength: 110,
        gravity: 0.18,
        gravityRangeCompound: 1.5,
        padding: 20,
      } as any,
    });

    // Centralised filter application — recomputed on any toolbar change.
    function applyFilters() {
      const q = (searchInput?.value ?? "").trim().toLowerCase();
      cy.batch(() => {
        cy.nodes().forEach((n) => {
          const domain = n.data("domain") as DomainId;
          const matchesDomain = enabled.has(domain);
          const matchesSearch =
            q === "" ||
            (n.data("label") as string).toLowerCase().includes(q) ||
            (n.data("summary") as string).toLowerCase().includes(q) ||
            domain.includes(q);
          const visible = matchesDomain && matchesSearch;
          n.style("display", visible ? "element" : "none");
          n.toggleClass("match", q !== "" && matchesSearch && matchesDomain);
        });
        cy.edges().forEach((e) => {
          const src = e.source();
          const tgt = e.target();
          const visible =
            src.style("display") !== "none" &&
            tgt.style("display") !== "none";
          e.style("display", visible ? "element" : "none");
        });
      });
    }

    // Hover highlight — focus the node + its direct neighbours.
    cy.on("mouseover", "node", (evt) => {
      const node = evt.target;
      cy.elements().addClass("dimmed");
      const neighbourhood = node.closedNeighborhood();
      neighbourhood.removeClass("dimmed");
      neighbourhood.edges().addClass("highlight");
      updateInfo(node.data());
    });
    cy.on("mouseout", "node", () => {
      cy.elements().removeClass("dimmed highlight");
      resetInfo();
    });

    // Click → navigate to the table detail page.
    cy.on("tap", "node", (evt) => {
      const slug = evt.target.data("slug") as string;
      if (slug) window.location.assign(`../${slug}/`);
    });

    // Toolbar wiring.
    searchInput?.addEventListener("input", applyFilters);

    domainListEl.querySelectorAll<HTMLInputElement>(
      "input[data-dbv-domain]",
    ).forEach((cb) => {
      cb.addEventListener("change", () => {
        const id = cb.dataset.dbvDomain as DomainId | undefined;
        if (!id) return;
        if (cb.checked) enabled.add(id);
        else enabled.delete(id);
        applyFilters();
      });
    });

    root.querySelector<HTMLButtonElement>("[data-dbv-all]")
      ?.addEventListener("click", () => {
        enabled.clear();
        data.domains.forEach((d) => enabled.add(d.id));
        domainListEl.querySelectorAll<HTMLInputElement>(
          "input[data-dbv-domain]",
        ).forEach((cb) => { cb.checked = true; });
        applyFilters();
      });

    root.querySelector<HTMLButtonElement>("[data-dbv-none]")
      ?.addEventListener("click", () => {
        enabled.clear();
        domainListEl.querySelectorAll<HTMLInputElement>(
          "input[data-dbv-domain]",
        ).forEach((cb) => { cb.checked = false; });
        applyFilters();
      });

    root.querySelector<HTMLButtonElement>("[data-dbv-relayout]")
      ?.addEventListener("click", () => {
        cy.layout({ name: "cose-bilkent", animate: true, animationDuration: 600 } as any).run();
      });

    root.querySelector<HTMLButtonElement>("[data-dbv-fit]")
      ?.addEventListener("click", () => {
        cy.fit(undefined, 24);
      });

    function updateInfo(nodeData: any) {
      if (!infoEl) return;
      const summary = nodeData.summary || "(no description)";
      infoEl.innerHTML = `
        <h3 class="dbv-info-name">${nodeData.label}</h3>
        <p class="dbv-info-domain"><span class="dbv-info-swatch" style="background:${nodeData.colour}"></span>${nodeData.domain}</p>
        <p class="dbv-info-summary">${summary}</p>
        <p class="dbv-info-stats">
          <span><strong>${nodeData.columnCount}</strong> columns</span>
          <span><strong>${nodeData.fkOutCount}</strong> outbound FK${nodeData.fkOutCount === 1 ? "" : "s"}</span>
          <span><strong>${nodeData.fkInCount}</strong> inbound FK${nodeData.fkInCount === 1 ? "" : "s"}</span>
        </p>
        <p class="dbv-info-cta">Click to open table page →</p>
      `;
    }
    function resetInfo() {
      if (!infoEl) return;
      infoEl.innerHTML = `<p class="dbv-info-hint">Click a node to open its detail page · drag a node to rearrange · scroll to zoom · drag empty space to pan.</p>`;
    }
  }

  document.querySelectorAll<HTMLElement>("[data-dbv]").forEach(init);
</script>

<style>
  .dbv-shell {
    --dbv-bg: var(--sl-color-bg-nav, #161b22);
    --dbv-border: var(--sl-color-hairline, #30363d);
    --dbv-canvas-bg: var(--sl-color-bg, #0d1117);
    margin: 1.25rem 0 2rem;
    border: 1px solid var(--dbv-border);
    border-radius: 12px;
    background: var(--dbv-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .dbv-toolbar {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr) auto;
    gap: 0.85rem 1.1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--dbv-border);
    align-items: flex-start;
  }

  .dbv-search { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .dbv-search-label,
  .dbv-domains-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--sl-color-gray-3, #8b949e);
  }
  .dbv-search input {
    padding: 0.45rem 0.65rem;
    font: inherit;
    font-size: 0.88rem;
    color: var(--sl-color-white, #e6edf3);
    background: var(--dbv-canvas-bg);
    border: 1px solid var(--dbv-border);
    border-radius: 6px;
    width: 100%;
  }
  .dbv-search input:focus-visible {
    outline: 2px solid var(--aa-feature, #7c3aed);
    outline-offset: 1px;
  }

  .dbv-domains { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .dbv-domain-buttons { display: flex; gap: 0.35rem; }
  .dbv-domain-all,
  .dbv-domain-none {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    color: var(--sl-color-gray-3, #8b949e);
    background: transparent;
    border: 1px dashed var(--dbv-border);
    border-radius: 4px;
    cursor: pointer;
  }
  .dbv-domain-all:hover,
  .dbv-domain-none:hover {
    border-color: var(--aa-feature, #7c3aed);
    color: var(--sl-color-white, #e6edf3);
  }
  .dbv-domain-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .dbv-domain-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--dbv-border);
    background: var(--dbv-canvas-bg);
    font-size: 0.74rem;
    color: var(--sl-color-gray-2, #c9d1d9);
    cursor: pointer;
    text-transform: capitalize;
  }
  .dbv-domain-chip:has(input:checked) {
    border-color: var(--dbv-domain-color, #7c3aed);
    color: var(--sl-color-white, #e6edf3);
  }
  .dbv-domain-chip:has(input:not(:checked)) {
    opacity: 0.55;
  }
  .dbv-domain-chip input { display: none; }
  .dbv-domain-swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--dbv-domain-color, #7c3aed);
    display: inline-block;
  }
  .dbv-domain-count {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    color: var(--sl-color-gray-3, #8b949e);
  }

  .dbv-actions {
    display: flex;
    gap: 0.4rem;
    align-self: end;
  }
  .dbv-actions button {
    font-size: 0.78rem;
    padding: 0.3rem 0.65rem;
    color: var(--sl-color-gray-2, #c9d1d9);
    background: transparent;
    border: 1px solid var(--dbv-border);
    border-radius: 6px;
    cursor: pointer;
  }
  .dbv-actions button:hover {
    border-color: var(--aa-feature, #7c3aed);
    color: var(--sl-color-white, #e6edf3);
  }

  .dbv-stage {
    display: grid;
    grid-template-columns: 1fr minmax(220px, 260px);
    min-height: 560px;
  }
  .dbv-canvas {
    width: 100%;
    height: 580px;
    background: var(--dbv-canvas-bg);
    border-right: 1px solid var(--dbv-border);
  }
  .dbv-info {
    padding: 1rem 1rem 1.2rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2, #c9d1d9);
  }
  .dbv-info-hint {
    margin: 0;
    color: var(--sl-color-gray-3, #8b949e);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .dbv-info-name {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    color: var(--sl-color-white, #e6edf3);
    font-family: var(--sl-font-mono, ui-monospace, monospace);
  }
  .dbv-info-domain {
    margin: 0 0 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-gray-3, #8b949e);
  }
  .dbv-info-swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .dbv-info-summary {
    margin: 0 0 0.8rem;
    line-height: 1.5;
  }
  .dbv-info-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    margin: 0 0 0.6rem;
    padding: 0;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3, #8b949e);
  }
  .dbv-info-stats strong {
    color: var(--sl-color-white, #e6edf3);
    font-family: var(--sl-font-mono, ui-monospace, monospace);
  }
  .dbv-info-cta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--aa-feature, #7c3aed);
    font-weight: 600;
  }

  /* Stage collapses to single column on narrow viewports. */
  @media (max-width: 820px) {
    .dbv-stage { grid-template-columns: 1fr; }
    .dbv-canvas { height: 420px; border-right: none; border-bottom: 1px solid var(--dbv-border); }
    .dbv-toolbar { grid-template-columns: 1fr; }
  }

  :root[data-theme="light"] .dbv-shell {
    --dbv-bg: #ffffff;
    --dbv-canvas-bg: #f6f8fa;
  }
</style>
