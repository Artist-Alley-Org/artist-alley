---
// Starlight Hero override — splash-template only.
//
// Wraps Starlight's hero data in a richer chrome:
//   - Animated radial+linear gradient background (CSS-only, reduced-motion safe)
//   - Subtle brand-purple dot grid overlay
//   - Status pill driven by the structured roadmap.json (current focus phase)
//   - Headline / tagline / CTAs from frontmatter `hero.*` (Starlight contract)
//   - Stat strip pulled from the GitHub snapshot
//
// Falls back gracefully when roadmap.json or github snapshot is missing.

import { Image } from "astro:assets";
import { getEntry } from "astro:content";

// Starlight does not export these from its public type surface, so we hardcode
// the values rather than reach into its private module paths.
const PAGE_TITLE_ID = "_top"; // matches Starlight's constants.ts

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {};

// --- Background image variants (handle dark/light/file/html cases) ----------
const imageAttrs = {
  loading: "eager" as const,
  decoding: "async" as const,
  width: 480,
  height: 480,
  alt: (image && "alt" in image && image.alt) || "",
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
  if ("file" in image) darkImage = image.file;
  else if ("dark" in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else rawHtml = image.html;
}

// --- Status pill: read from roadmap.json -----------------------------------
const roadmapEntry = await getEntry("roadmap", "roadmap");
const roadmap = roadmapEntry?.data;
const inFlightSection = roadmap?.sections.find(
  (s) => s.id === "in-flight" && s.kind === "items",
) as { kind: "items"; items: Array<{ phase?: string; title: string; status?: string }> } | undefined;
const currentFocus = inFlightSection?.items.find((i) => i.status === "in-flight");
const statusPhase = currentFocus?.phase ?? "1.18.B";
const statusBlurb = currentFocus?.title ?? "pre-MVP";

// --- Stat strip: github snapshot --------------------------------------------
const ghEntry = await getEntry("github", "snapshot");
const gh = ghEntry?.data;
const fmt = (n: number) => n.toLocaleString();
const latestTag = gh?.releases?.[0]?.tag_name;
---

<section class="hero-x" data-reveal>
  {/* Animated background layers */}
  <div class="hero-x-bg" aria-hidden="true">
    <div class="hero-x-bg-gradient" />
    <div class="hero-x-bg-grid" />
    <div class="hero-x-bg-glow hero-x-bg-glow--a" />
    <div class="hero-x-bg-glow hero-x-bg-glow--b" />
  </div>

  <div class="hero-x-inner">
    <div class="hero-x-copy">
      <a class="hero-x-pill" href="/roadmap/">
        <span class="hero-x-pill-dot" aria-hidden="true"></span>
        <span class="hero-x-pill-eyebrow">phase {statusPhase}</span>
        <span class="hero-x-pill-sep" aria-hidden="true">·</span>
        <span class="hero-x-pill-text">{statusBlurb}</span>
        <span class="hero-x-pill-arrow" aria-hidden="true">→</span>
      </a>

      <h1
        id={PAGE_TITLE_ID}
        data-page-title
        class="hero-x-title"
        set:html={title}
      />
      {tagline && <p class="hero-x-tagline" set:html={tagline} />}

      {actions.length > 0 && (
        <div class="hero-x-actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant = "primary" }) => (
              <a
                href={href}
                class:list={["sl-link-button not-content", variant, className]}
                {...attrs}
              >
                <span>{text}</span>
                {icon?.html && <Fragment set:html={icon.html} />}
              </a>
            ),
          )}
        </div>
      )}

      {gh && (
        <ul class="hero-x-stats" aria-label="Repo at a glance">
          <li>
            <span class="hero-x-stat-num">{fmt(gh.commits?.length ?? 0)}</span>
            <span class="hero-x-stat-label">recent commits</span>
          </li>
          <li>
            <span class="hero-x-stat-num">{fmt(gh.issues?.open?.length ?? 0)}</span>
            <span class="hero-x-stat-label">open issues</span>
          </li>
          <li>
            <span class="hero-x-stat-num">{fmt(gh.pulls?.open?.length ?? 0)}</span>
            <span class="hero-x-stat-label">open PRs</span>
          </li>
          <li>
            <span class="hero-x-stat-num">{latestTag ?? "—"}</span>
            <span class="hero-x-stat-label">latest tag</span>
          </li>
        </ul>
      )}
    </div>

    <div class="hero-x-art">
      {darkImage && (
        <Image
          src={darkImage}
          {...imageAttrs}
          class:list={["hero-x-logo", { "light:sl-hidden": Boolean(lightImage) }]}
        />
      )}
      {lightImage && (
        <Image src={lightImage} {...imageAttrs} class="hero-x-logo dark:sl-hidden" />
      )}
      {rawHtml && <div class="hero-x-html" set:html={rawHtml} />}
    </div>
  </div>
</section>

<style>
  @layer starlight.core {
    .hero-x {
      position: relative;
      isolation: isolate;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem);
      margin: 0 calc(-1 * var(--sl-content-pad-x, 1rem)) 2rem;
      border-radius: 0 0 22px 22px;
      overflow: hidden;
    }

    /* ----- Background ----- */
    .hero-x-bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }
    .hero-x-bg-gradient {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(13, 17, 23, 0) 0%, rgba(13, 17, 23, 0.6) 100%),
        linear-gradient(120deg, #0d1117 0%, #14182a 50%, #0d1117 100%);
      background-size: 200% 200%;
      animation: heroXShift 18s ease-in-out infinite;
    }
    .hero-x-bg-grid {
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle, rgba(124, 58, 237, 0.08) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 30%, transparent 75%);
    }
    .hero-x-bg-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.45;
      mix-blend-mode: screen;
    }
    .hero-x-bg-glow--a {
      width: 520px; height: 520px;
      top: -160px; left: -120px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.6), transparent 65%);
      animation: heroXFloatA 22s ease-in-out infinite;
    }
    .hero-x-bg-glow--b {
      width: 420px; height: 420px;
      bottom: -140px; right: -100px;
      background: radial-gradient(circle, rgba(46, 160, 67, 0.5), transparent 65%);
      animation: heroXFloatB 26s ease-in-out infinite;
    }

    @keyframes heroXShift {
      0%, 100% { background-position: 0% 50%, 0% 0%; }
      50% { background-position: 100% 50%, 0% 0%; }
    }
    @keyframes heroXFloatA {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(40px, 30px); }
    }
    @keyframes heroXFloatB {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-30px, -40px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-x-bg-gradient,
      .hero-x-bg-glow { animation: none; }
    }

    /* ----- Layout ----- */
    .hero-x-inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    @media (min-width: 50rem) {
      .hero-x-inner { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
    }

    .hero-x-copy {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* ----- Status pill ----- */
    .hero-x-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      align-self: flex-start;
      padding: 0.35rem 0.85rem;
      background: rgba(124, 58, 237, 0.1);
      border: 1px solid rgba(124, 58, 237, 0.4);
      border-radius: 999px;
      font-size: 0.78rem;
      color: var(--sl-color-white, #e6edf3);
      text-decoration: none;
      transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }
    .hero-x-pill:hover {
      background: rgba(124, 58, 237, 0.18);
      border-color: rgba(124, 58, 237, 0.7);
      transform: translateY(-1px);
    }
    .hero-x-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(210, 153, 34, 1);
      box-shadow: 0 0 0 0 rgba(210, 153, 34, 0.6);
      animation: heroXPulse 1.8s ease-in-out infinite;
    }
    @keyframes heroXPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(210, 153, 34, 0.5); }
      50% { box-shadow: 0 0 0 6px rgba(210, 153, 34, 0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-x-pill-dot { animation: none; }
    }
    .hero-x-pill-eyebrow {
      font-family: var(--sl-font-mono, ui-monospace, monospace);
      font-weight: 600;
      letter-spacing: 0.04em;
      color: rgba(124, 58, 237, 1);
    }
    .hero-x-pill-sep { color: var(--sl-color-gray-3, #8b949e); }
    .hero-x-pill-text { color: var(--sl-color-gray-1, #e6edf3); }
    .hero-x-pill-arrow {
      color: var(--sl-color-gray-3, #8b949e);
      transition: transform 160ms ease;
    }
    .hero-x-pill:hover .hero-x-pill-arrow { transform: translateX(2px); }

    /* ----- Headline + tagline ----- */
    .hero-x-title {
      margin: 0;
      font-size: clamp(2.25rem, calc(1.25rem + 4.5vw), 4.5rem);
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--sl-color-white, #fff);
      text-wrap: balance;
      background: linear-gradient(180deg, #ffffff 0%, #c9d1d9 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-x-tagline {
      margin: 0;
      font-size: clamp(1rem, calc(0.75rem + 0.6vw), 1.2rem);
      line-height: 1.5;
      color: var(--sl-color-gray-2, #c9d1d9);
      max-width: 56ch;
      text-wrap: pretty;
    }

    /* ----- Action buttons ----- */
    .hero-x-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    /* ----- Stat strip ----- */
    .hero-x-stats {
      list-style: none;
      padding: 1rem 1.25rem;
      margin: 0.75rem 0 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 0.5rem 1.5rem;
      background: rgba(13, 17, 23, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--sl-color-hairline, #30363d);
      border-radius: 12px;
    }
    .hero-x-stats li {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .hero-x-stat-num {
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1;
      color: var(--sl-color-white, #fff);
      font-feature-settings: "tnum" 1, "lnum" 1;
      letter-spacing: -0.01em;
    }
    .hero-x-stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--sl-color-gray-3, #8b949e);
    }

    /* ----- Logo art ----- */
    .hero-x-art {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .hero-x-logo {
      width: min(75%, 22rem);
      height: auto;
      filter: drop-shadow(0 20px 40px rgba(124, 58, 237, 0.25));
      animation: heroXLogoFloat 7s ease-in-out infinite;
    }
    @keyframes heroXLogoFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-x-logo { animation: none; }
    }
    @media (min-width: 50rem) {
      .hero-x-art { order: 2; }
    }
  }
</style>
