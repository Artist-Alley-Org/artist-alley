---
// GitHub-style 52-week commit heatmap.
// Pure SVG. Reads `commitActivity` from the github snapshot collection.
// commitActivity shape (GitHub stats API): array of up to 52 entries:
//   { week: <unix epoch seconds>, total: number, days?: number[] }

import { getEntry } from "astro:content";

interface Props {
  /** Override the snapshot entry id; default `"snapshot"`. */
  entryId?: string;
  /** Height of each cell in px. Default 12. */
  cell?: number;
  /** Gap between cells in px. Default 3. */
  gap?: number;
}

const { entryId = "snapshot", cell = 12, gap = 3 } = Astro.props;

const entry = await getEntry("github", entryId);
const activity = entry?.data.commitActivity ?? [];

/**
 * Build a 7-rows × 52-columns matrix where:
 *   - rows are days of week (Sun=0..Sat=6)
 *   - cols are weeks (oldest -> newest, left to right)
 *
 * GitHub's stats endpoint returns weeks with .days[] of length 7 (Sun..Sat).
 * If a snapshot is stub or no days[], we synthesize a column where the entire
 * week's total is split across Wednesday (visible row) for a minimal stub.
 */
const weeks = activity.slice(-52);
const cols = weeks.length || 1;
const rows = 7;

const matrix: number[][] = Array.from({ length: rows }, () =>
  Array(cols).fill(0),
);

weeks.forEach((w, colIdx) => {
  if (Array.isArray(w.days) && w.days.length === 7) {
    w.days.forEach((d: number, r) => {
      matrix[r][colIdx] = d;
    });
  } else {
    matrix[3][colIdx] = w.total ?? 0;
  }
});

// Find max for scaling buckets.
const allValues = matrix.flat();
const max = Math.max(...allValues, 1);
const total = allValues.reduce((a, b) => a + b, 0);
const activeDays = allValues.filter((n) => n > 0).length;

/** Bucket 0..4 based on quintiles of `max`. 0 = empty. */
function bucket(n: number): 0 | 1 | 2 | 3 | 4 {
  if (n <= 0) return 0;
  const pct = n / max;
  if (pct < 0.25) return 1;
  if (pct < 0.5) return 2;
  if (pct < 0.75) return 3;
  return 4;
}

const cellSize = cell;
const cellGap = gap;
const width = cols * (cellSize + cellGap) - cellGap;
const height = rows * (cellSize + cellGap) - cellGap;

// Month labels: walk weeks left-to-right, emit a label only when the month
// changes vs the prior column. Position the label at the column.
type MonthLabel = { x: number; text: string };
const monthLabels: MonthLabel[] = [];
let lastMonth = -1;
weeks.forEach((w, colIdx) => {
  if (!w.week) return;
  const d = new Date(w.week * 1000);
  const m = d.getMonth();
  if (m !== lastMonth) {
    monthLabels.push({
      x: colIdx * (cellSize + cellGap),
      text: d.toLocaleString(undefined, { month: "short" }),
    });
    lastMonth = m;
  }
});

const dayLabels = ["", "Mon", "", "Wed", "", "Fri", ""]; // GitHub style
const isStub = activity.length === 0;
---

<figure class="cmh" aria-label="GitHub commit activity heatmap, last 52 weeks">
  <figcaption class="cmh-caption">
    <span>
      <strong>{total.toLocaleString()}</strong> commits over the last
      <strong>{weeks.length}</strong> weeks
      {activeDays > 0 && (
        <>
          {" — "}
          <strong>{activeDays}</strong> active days
        </>
      )}
    </span>
    <span class="cmh-legend" aria-hidden="true">
      Less
      <span class="cmh-swatch" data-level="0" />
      <span class="cmh-swatch" data-level="1" />
      <span class="cmh-swatch" data-level="2" />
      <span class="cmh-swatch" data-level="3" />
      <span class="cmh-swatch" data-level="4" />
      More
    </span>
  </figcaption>

  {isStub ? (
    <p class="cmh-empty">
      No commit activity yet. The GitHub stats endpoint needs a few hours of
      pre-computation after the first repo activity — re-run
      <code>pnpm refresh-github</code> later.
    </p>
  ) : (
    <div class="cmh-svg-wrap">
      <svg
        class="cmh-svg"
        viewBox={`0 0 ${width + 32} ${height + 22}`}
        preserveAspectRatio="xMinYMin meet"
        role="img"
      >
        {/* Day labels */}
        <g class="cmh-days" transform="translate(0, 22)">
          {dayLabels.map((label, r) =>
            label ? (
              <text
                x={28}
                y={r * (cellSize + cellGap) + cellSize - 2}
                text-anchor="end"
                class="cmh-axis"
              >
                {label}
              </text>
            ) : null,
          )}
        </g>

        {/* Month labels */}
        <g transform="translate(32, 14)" class="cmh-months">
          {monthLabels.map((m) => (
            <text x={m.x} y={0} class="cmh-axis">{m.text}</text>
          ))}
        </g>

        {/* Cells */}
        <g transform="translate(32, 22)">
          {matrix.flatMap((row, r) =>
            row.map((value, c) => {
              const lvl = bucket(value);
              const week = weeks[c];
              const dateLabel = week?.week
                ? new Date((week.week + r * 86400) * 1000).toLocaleDateString(
                    undefined,
                    { year: "numeric", month: "short", day: "numeric" },
                  )
                : "";
              return (
                <rect
                  x={c * (cellSize + cellGap)}
                  y={r * (cellSize + cellGap)}
                  width={cellSize}
                  height={cellSize}
                  rx="2"
                  class="cmh-cell"
                  data-level={lvl}
                >
                  <title>{value} commits — {dateLabel}</title>
                </rect>
              );
            }),
          )}
        </g>
      </svg>
    </div>
  )}
</figure>

<style>
  .cmh {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .cmh-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3, #8b949e);
  }
  .cmh-caption strong { color: var(--sl-color-white, #e6edf3); font-weight: 600; }

  .cmh-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
  }
  .cmh-swatch {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }
  .cmh-swatch[data-level="0"] { background: rgba(110, 118, 129, 0.2); }
  .cmh-swatch[data-level="1"] { background: rgba(46, 160, 67, 0.32); }
  .cmh-swatch[data-level="2"] { background: rgba(46, 160, 67, 0.55); }
  .cmh-swatch[data-level="3"] { background: rgba(46, 160, 67, 0.78); }
  .cmh-swatch[data-level="4"] { background: rgba(46, 160, 67, 1); }

  .cmh-svg-wrap {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .cmh-svg {
    display: block;
    min-width: 720px;
    width: 100%;
    height: auto;
  }

  .cmh-cell {
    transition: stroke 80ms ease, transform 80ms ease;
    fill: rgba(110, 118, 129, 0.18);
  }
  .cmh-cell[data-level="0"] { fill: rgba(110, 118, 129, 0.16); }
  .cmh-cell[data-level="1"] { fill: rgba(46, 160, 67, 0.32); }
  .cmh-cell[data-level="2"] { fill: rgba(46, 160, 67, 0.55); }
  .cmh-cell[data-level="3"] { fill: rgba(46, 160, 67, 0.80); }
  .cmh-cell[data-level="4"] { fill: rgba(46, 160, 67, 1); }
  .cmh-cell:hover {
    stroke: var(--sl-color-white, #e6edf3);
    stroke-width: 1;
  }

  .cmh-axis {
    font-size: 10px;
    fill: var(--sl-color-gray-3, #8b949e);
    font-family: var(--sl-font-system);
  }

  .cmh-empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--sl-color-hairline, #30363d);
    border-radius: 8px;
    color: var(--sl-color-gray-3, #8b949e);
    font-size: 0.9rem;
  }
  .cmh-empty code {
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    background: var(--sl-color-bg-inline-code, rgba(110, 118, 129, 0.16));
    border-radius: 4px;
  }
</style>
