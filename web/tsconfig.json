{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    // Inherit svelte-kit's "node" via the spread-like merge that TS
    // does for `types` — we replace, not extend, so re-declare it.
    // vitest/globals adds describe / it / expect ambient types for
    // .test.ts files; @testing-library/jest-dom layers the DOM
    // matchers (`toBeInTheDocument`, etc.) onto expect.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  }
}
