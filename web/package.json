{
  "name": "artist-alley-web",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "artist-alley frontend (SvelteKit + Tailwind, embedded into the Go binary at build time).",
  "overrides": {
    "js-yaml": "^4.2.0",
    "cookie": "^0.7.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ${AA_OPENAPI_SPEC:-../app/api/openapi.yaml} -o src/lib/api/schema.d.ts",
    "postinstall": "svelte-kit sync && (test -f ${AA_OPENAPI_SPEC:-../app/api/openapi.yaml} && npm run generate:api || echo 'openapi.yaml not found yet; skipping API codegen')"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@scalar/api-reference": "^1.64.0",
    "@types/dompurify": "^3.2.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "hls.js": "^1.6.17",
    "marked": "^18.0.9",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "three": "^0.185.1",
    "thumbhash": "^0.1.1"
  }
}
