# Copy to .env and edit. .env is gitignored.

# Host user/group (so files written by the container match your local UID)
# On Linux/WSL find these with: id -u && id -g
UID=1000
GID=1000

# Timezone for all services
TZ=UTC

# Nginx port exposed on the host
NGINX_HTTP_PORT=8080

# --- MySQL (ResourceSpace's database) ---
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=resourcespace
MYSQL_USER=resourcespace
MYSQL_PASSWORD=change-me-rs

# --- Postgres + pgvector (artist-alley's adjunct DB) ---
POSTGRES_HOST_PORT=5432
POSTGRES_DB=artist_alley
POSTGRES_USER=artist_alley
POSTGRES_PASSWORD=change-me-pg
