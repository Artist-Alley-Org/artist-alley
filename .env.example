# Copy to .env and edit. .env is gitignored.

# Host user/group (so files written by the container match your local UID)
# On Linux/WSL find these with: id -u && id -g
UID=1000
GID=1000

# Timezone for all services
TZ=UTC

# Nginx port exposed on the host.
#
# Deliberately NOT 8080 (#360): 8080 and 5432 are the two most
# commonly-squatted ports on a developer or self-hosted box — a
# torrent client, another Postgres, some admin UI. A fresh clone that
# picks them fails to bind with a driver error that reads like a
# compose bug rather than "something else owns this port". These
# defaults are free on our boxes; override per-machine if not on yours.
NGINX_HTTP_PORT=8088

# --- Postgres + pgvector (application DB) ---
POSTGRES_HOST_PORT=5433
POSTGRES_DB=artist_alley
POSTGRES_USER=artist_alley
POSTGRES_PASSWORD=change-me-pg

# --- Auth ---
# Both values are REQUIRED — docker-compose.yml refuses to start without
# them. `scripts/bootstrap.sh` replaces these placeholders with generated
# secrets when it creates your .env; the commands it uses are given here
# so an install that writes its own .env produces the same shapes.

# Static per-install pepper mixed into bcrypt password hashes.
#   openssl rand -hex 32
AA_SCRAMBLE_KEY=change-me-scramble

# At-rest encryption master key: base64-encoded 32 bytes. The app rejects
# any other shape and exits at boot (#996 — this line was missing
# entirely, so a fresh clone's .env could not start the stack).
#   openssl rand -base64 32
AA_MASTER_KEY=change-me-master-key

# --- Storage backend ---
# Backend = "fs" (default, local FS) or "s3" (AWS, MinIO, R2, B2, ...).
AA_STORAGE_BACKEND=fs
AA_STORAGE_FS_ROOT=/var/lib/artist-alley/storage
# Set these when AA_STORAGE_BACKEND=s3:
# AA_STORAGE_S3_ENDPOINT=http://minio:9000
# AA_STORAGE_S3_REGION=us-east-1
# AA_STORAGE_S3_BUCKET=artist-alley
# AA_STORAGE_S3_ACCESS_KEY=
# AA_STORAGE_S3_SECRET_KEY=
# AA_STORAGE_S3_USE_PATH_STYLE=true

# --- MinIO (only when running `docker compose --profile storage-s3 up`) ---
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=aaminio
MINIO_ROOT_PASSWORD=change-me-minio
