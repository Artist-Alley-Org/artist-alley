# Anything noisy or environment-specific stays out of the build
# context so multi-arch builds stay fast and the layer hashes are
# reproducible.

# VCS + IDE
.git
.github
.gitignore
.dockerignore
.editorconfig
.vscode
.idea

# Local env + secrets
.env
.env.*
!.env.example

# Test artefacts + reports
*.log
coverage.*
.playwright-mcp/
.svelte-kit/
*.cover.out
*.out

# Node + Go build outputs that the multi-stage rebuilds anyway
web/node_modules
web/build
app/internal/http/static_assets/*
!app/internal/http/static_assets/.embed-placeholder
!app/internal/http/static_assets/.gitignore

# Dev-time storage + database state
filestore/
storage/
postgres-data/

# Screenshots, scratch images, working PDFs
*.png
!web/static/**/*.png
*.jpg
*.jpeg
*.pdf

# Docker Compose dev overrides
docker-compose.override.yml

# Local docs build output
site/build
site/.astro
site/.vercel

# OS junk
.DS_Store
Thumbs.db

# Legacy reference tree — never shipped in the runtime image.
# Kept in .dockerignore as a safety net in case any operator has
# stray copies from earlier snapshots on the build context path.
plugins/
languages/
include/
pages/
api/
batch/
hooks/
