# artist-alley — runtime configuration.
#
# A template, not a file the binary reads: artist-alley takes its settings
# from environment variables. Copy this file to /etc/artist-alley/aa.env and
# edit; the systemd unit sources it via EnvironmentFile=, and the Docker image
# accepts the same variables (pass them with -e or an env_file).
#
# Required (no sensible default — service won't start without them):
#   AA_DB_PASSWORD
#   AA_SCRAMBLE_KEY
#   AA_MASTER_KEY
#
# See the install guide for the full reference:
#   https://github.com/Artist-Alley-Org/artist-alley/blob/main/docs/install/README.md

# ── HTTP listener ─────────────────────────────────────────────────────────
AA_HTTP_ADDR=":8080"

# ── Postgres ──────────────────────────────────────────────────────────────
AA_DB_HOST="localhost"
AA_DB_PORT="5432"
AA_DB_NAME="artist_alley"
AA_DB_USER="artist_alley"
AA_DB_PASSWORD="change-me"
AA_DB_SSLMODE="disable"

# Connection pool sizing (pgx). Defaults shown.
#AA_DB_MAX_CONNS="20"
#AA_DB_MIN_CONNS="2"
#AA_DB_CONN_MAX_LIFETIME="1h"

# ── Storage backend ───────────────────────────────────────────────────────
# `fs` (default) stores byte blobs under AA_STORAGE_FS_ROOT.
# `s3` uses any S3-compatible API (AWS, MinIO, Backblaze B2, R2, ...).
AA_STORAGE_BACKEND="fs"
AA_STORAGE_FS_ROOT="/var/lib/artist-alley"

# Uncomment when using S3:
#AA_STORAGE_BACKEND="s3"
#AA_STORAGE_S3_BUCKET="artist-alley"
#AA_STORAGE_S3_REGION="us-east-1"
#AA_STORAGE_S3_ENDPOINT=""              # MinIO/B2/R2: full URL with scheme
#AA_STORAGE_S3_ACCESS_KEY=""
#AA_STORAGE_S3_SECRET_KEY=""
#AA_STORAGE_S3_USE_PATH_STYLE="true"    # default true; MinIO needs this

# ── Logging ───────────────────────────────────────────────────────────────
AA_LOG_LEVEL="info"
AA_LOG_FORMAT="json"

# ── Memory ceiling ────────────────────────────────────────────────────────
# The app derives GOMEMLIMIT from the container's own cgroup limit at
# boot, because the Go runtime does not read cgroup limits on its own and
# would otherwise grow the heap straight through the container ceiling
# during preview rendering (ADR 0082).
#
# AA_APP_MEM_LIMIT is the container ceiling itself, consumed by compose
# (`mem_limit`). Raise it for an instance with a large catalogue and heavy
# preview concurrency; the Go runtime follows automatically — there is no
# second number to keep in sync. A ~150-asset preview render storm was
# measured at a 5.4 GB peak, so the 8g default is roughly 1.5x a small
# instance's burst; budget more if your workers run wide.
#AA_APP_MEM_LIMIT="8g"
#
# Fraction of that ceiling handed to the runtime. The headroom covers what
# GOMEMLIMIT does not: thread stacks, the binary itself, memory not yet
# returned to the OS, and — the big one — the ffmpeg / ghostscript /
# ImageMagick / headless-chromium children the preview pipeline spawns,
# which live in the same cgroup and were measured at 1.0 GB of resident
# memory at peak. 0 disables the derivation entirely and leaves the
# runtime default in place.
#AA_GOMEMLIMIT_RATIO="0.8"

# ── Memory instrumentation ────────────────────────────────────────────────
# ON by default. One `mem.sample` log line per interval carries three
# planes: the Go runtime's own accounting, the cgroup's accounting (the
# only view the OOM killer has), and a rollup of every child process the
# preview pipeline spawned. The first two disagree by gigabytes during a
# render storm, and the third is what attributes the difference.
#
# Sampling costs well under a millisecond and ~65 KB of short-lived
# allocation per interval. Set to 0 to switch the watcher off entirely.
#AA_MEM_SAMPLE_INTERVAL="15s"
#
# When cgroup usage crosses this fraction of the container ceiling, the
# app writes a heap profile + a goroutine dump and logs the full child
# process table, so a container that is OOM-killed leaves readable
# evidence with nobody watching. 0 disables captures, leaving sampling on.
#
# 0.8 matches AA_GOMEMLIMIT_RATIO on purpose: above that line the
# container is holding more than the Go heap was ever told it could have,
# which is precisely the condition worth a profile.
#AA_MEM_CAPTURE_THRESHOLD="0.8"
#
# Ring directory for captures. Container-local by default and NOT under
# the storage root: a heap profile contains live object contents (session
# tokens, decoded file bytes, DB rows), so it must never land somewhere
# that gets served. Pull captures out with:
#   docker compose cp app:/tmp/aa-memcapture ./memcapture
#AA_MEM_CAPTURE_DIR="/tmp/aa-memcapture"
#
# How many capture sets survive. Oldest are deleted on every capture, so
# the directory is bounded whatever happens.
#AA_MEM_CAPTURE_KEEP="5"
#
# Floor between two captures, so usage parked just above the threshold
# cannot spam the ring and evict the run-up it exists to hold.
#AA_MEM_CAPTURE_MIN_INTERVAL="2m"

# ── Profiling (net/http/pprof) ────────────────────────────────────────────
# OFF unless set. Serves pprof on a SEPARATE listener from the application
# router — the endpoints are never mounted on the API mux.
#
# A heap profile contains live object contents: session tokens, decoded
# file bytes, database rows. Bind loopback ONLY and reach it by exec'ing
# into the container; 0.0.0.0 inside a container is reachable from every
# other container on the network. Non-loopback binds log a WARN.
#AA_PPROF_ADDR="127.0.0.1:6060"

# ── Password-hashing pepper ───────────────────────────────────────────────
# Mixed into every password hash. Keep it stable across restarts.
# Generate with: openssl rand -hex 32
AA_SCRAMBLE_KEY="change-me-to-32-hex-bytes"

# ── At-rest encryption master key ─────────────────────────────────────────
# Base64-encoded 32 bytes. Generate with: openssl rand -base64 32
# REQUIRED — the service exits at startup without it. Losing this key
# means losing access to everything it encrypts; back it up.
AA_MASTER_KEY="change-me-to-base64-32-bytes"

# ── First-boot admin ──────────────────────────────────────────────────────
# On first boot, when no admin exists, the server creates an `admin`
# account with a random password and prints it to the log. It also tries
# to write it to bootstrap-admin.txt under this directory; the app user
# must be able to create and write the directory (in the published image
# the default is not writable, so read the password from the log).
#AA_BOOTSTRAP_ADMIN_PATH="/var/lib/artist-alley"
#
# Development only: 1 creates `admin` with the published default password
# instead of a random one. Never set it on a real install.
#AA_BOOTSTRAP_DEFAULT_ADMIN="0"

# ── Setup wizard prefills ─────────────────────────────────────────────────
# Optional values that prefill the first-run setup form, for scripted
# deployments. The form is only shown while no admin exists, so on a
# normal first boot (which creates `admin`, see above) these are unused.
# They have no effect after setup completes.
#AA_SETUP_DEFAULT_USERNAME=""
#AA_SETUP_DEFAULT_EMAIL=""
#AA_SETUP_DEFAULT_FULLNAME=""
#AA_SETUP_DEFAULT_SITE_NAME="Artist Alley"
#AA_SETUP_DEFAULT_BASE_URL=""
#AA_SETUP_DEFAULT_SMTP_HOST=""
#AA_SETUP_DEFAULT_SMTP_PORT="587"
#AA_SETUP_DEFAULT_SMTP_ENCRYPTION="starttls"   # none | starttls | tls
#AA_SETUP_DEFAULT_SMTP_USERNAME=""
#AA_SETUP_DEFAULT_SMTP_FROM=""

# ── Email delivery ────────────────────────────────────────────────────────
# smtp (the default when unset) sends through the SMTP settings configured
# in the admin UI; capture records mail in memory and never delivers it;
# disabled logs and drops every send. Unknown values fall back to smtp.
#AA_EMAIL_MODE="smtp"

# ── License file (optional) ───────────────────────────────────────────────
# No commercial or paid licenses are offered yet. When no file exists at
# AA_LICENSE_PATH the app runs with its built-in community defaults.
# AA_ORG_KEY_PATH is only used when an installed license requires an
# organization key.
#AA_LICENSE_PATH="/etc/artist-alley/license.lic"
#AA_ORG_KEY_PATH="/etc/artist-alley/org.key"

# ── Public demo ───────────────────────────────────────────────────────────
# Presentational only: 1 shows the shared demo credentials on the login
# card and a read-only demo banner. It does not make the instance read-only.
#AA_DEMO_MODE="0"
